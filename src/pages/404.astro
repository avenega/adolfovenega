---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada · Adolfo Venega" description="La página solicitada no existe.">
	<main class="site-shell" id="contenido" style="padding-block: 20vh 4rem;">
		<p class="section__eyebrow">404</p>
		<h1 class="hero__brand" style="max-width: none;">Página no encontrada</h1>
		<p class="hero__lede">El enlace no existe o se movió. Volvé al inicio del portafolio.</p>
		<a class="button button--primary" href="/">Ir al inicio</a>
	</main>
</Base>
