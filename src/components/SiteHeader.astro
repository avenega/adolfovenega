---
import { profile } from '../data/profile';

const links = [
	{ href: '#sobre-mi', label: 'Sobre mí' },
	{ href: '#experiencia', label: 'Experiencia' },
	{ href: '#proyectos', label: 'Proyectos' },
	{ href: '#habilidades', label: 'Habilidades' },
	{ href: '#contacto', label: 'Contacto' },
];
---

<header class="site-header">
	<div class="site-header__bar">
		<div class="site-shell site-header__inner">
			<a class="brand" href="#inicio">{profile.shortName.split(' ')[0]} <span>Venega</span></a>

			<nav class="site-nav" aria-label="Principal">
				<button
					class="icon-button menu-button"
					type="button"
					popovertarget="site-menu"
					popovertargetaction="toggle"
					aria-controls="site-menu"
					aria-label="Abrir menú"
				>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M4 7h16M4 12h16M4 17h16"></path>
					</svg>
				</button>

				<ul id="site-menu" class="site-menu" popover="auto" data-nav>
					{
						links.map((link) => (
							<li>
								<a href={link.href} data-nav-link>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<div class="header-actions">
				<button
					type="button"
					class="icon-button theme-toggle"
					id="theme-toggle"
					aria-label="Cambiar tema"
				>
					<svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
						<path d="M21 14.3A8.5 8.5 0 0 1 9.7 3 7 7 0 1 0 21 14.3Z"></path>
					</svg>
					<svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
						<circle cx="12" cy="12" r="4"></circle>
						<path
							d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
						></path>
					</svg>
				</button>
			</div>
		</div>
	</div>
</header>

<script>
	if (!Object.hasOwn(HTMLElement.prototype, 'popover')) {
		void import('@oddbird/popover-polyfill');
	}

	const meta = document.querySelector('meta[name="color-scheme"]');
	const themeBtn = document.getElementById('theme-toggle');
	const header = document.querySelector('.site-header');
	const inner = document.querySelector('.site-header__inner');
	const menu = document.getElementById('site-menu');
	const menuButton = document.querySelector('.menu-button');

	const getSystemScheme = () =>
		window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';

	const getRenderedScheme = () => {
		const stored = meta instanceof HTMLMetaElement ? meta.content : 'light dark';
		if (stored === 'light' || stored === 'dark') return stored;
		return getSystemScheme();
	};

	const applyScheme = (value: string | null) => {
		if (!(meta instanceof HTMLMetaElement)) return;
		if (!value) {
			meta.content = 'light dark';
			try {
				localStorage.removeItem('color-scheme');
			} catch {}
			return;
		}
		meta.content = value;
		try {
			localStorage.setItem('color-scheme', value);
		} catch {}
	};

	const syncThemeLabel = () => {
		if (!(themeBtn instanceof HTMLButtonElement)) return;
		themeBtn.setAttribute(
			'aria-label',
			getRenderedScheme() === 'dark' ? 'Cambiar a tema claro' : 'Cambiar a tema oscuro',
		);
	};

	syncThemeLabel();

	themeBtn?.addEventListener('click', () => {
		const current = getRenderedScheme();
		const target = current === 'dark' ? 'light' : 'dark';
		if (target === getSystemScheme()) {
			applyScheme(null);
		} else {
			applyScheme(target);
		}
		syncThemeLabel();
	});

	window.addEventListener('storage', (event) => {
		if (event.key !== 'color-scheme' || !(meta instanceof HTMLMetaElement)) return;
		meta.content = event.newValue ?? 'light dark';
	});

	let lastCollapsedWidth = 0;

	const isMenuOpen = () => {
		if (!(menu instanceof HTMLElement)) return false;
		return menu.matches(':popover-open, .\\:popover-open');
	};

	const clearMenuPosition = () => {
		if (!(menu instanceof HTMLElement)) return;
		menu.style.top = '';
		menu.style.left = '';
		menu.style.right = '';
	};

	const placeMenuNearButton = () => {
		if (
			!(menu instanceof HTMLElement) ||
			!(menuButton instanceof HTMLElement) ||
			!(header instanceof HTMLElement) ||
			header.classList.contains('is-wide') ||
			CSS.supports('position-area', 'block-end')
		) {
			return;
		}

		const trigger = menuButton.getBoundingClientRect();
		const panel = menu.getBoundingClientRect();
		const gap = 8;
		const gutter = 12;
		let top = trigger.bottom + gap;
		let left = trigger.right - panel.width;

		if (top + panel.height > window.innerHeight - gutter) {
			top = Math.max(gutter, trigger.top - panel.height - gap);
		}
		left = Math.min(left, window.innerWidth - panel.width - gutter);
		left = Math.max(gutter, left);

		menu.style.top = `${top}px`;
		menu.style.left = `${left}px`;
		menu.style.right = 'auto';
	};

	const syncNavLayout = () => {
		if (
			!(header instanceof HTMLElement) ||
			!(inner instanceof HTMLElement) ||
			!(menu instanceof HTMLElement)
		) {
			return;
		}

		const wasOpen = isMenuOpen();
		const currentlyWide = header.classList.contains('is-wide');

		if (!currentlyWide && lastCollapsedWidth > 0 && inner.clientWidth < lastCollapsedWidth) {
			return;
		}

		header.classList.add('is-measuring', 'is-wide');
		menu.removeAttribute('popover');

		const fits = inner.scrollWidth <= inner.clientWidth + 1;
		header.classList.toggle('is-wide', fits);

		if (fits) {
			menu.removeAttribute('popover');
			clearMenuPosition();
			lastCollapsedWidth = 0;
		} else {
			menu.setAttribute('popover', 'auto');
			lastCollapsedWidth = inner.clientWidth;
			if (wasOpen && 'showPopover' in menu) {
				try {
					(menu as HTMLElement & { showPopover: () => void }).showPopover();
				} catch {}
			}
		}

		requestAnimationFrame(() => {
			header.classList.remove('is-measuring');
		});
	};

	if (header instanceof HTMLElement && menu instanceof HTMLElement) {
		const resizeObserver = new ResizeObserver(() => syncNavLayout());
		resizeObserver.observe(header);
		resizeObserver.observe(menu);
		if (document.fonts?.ready) {
			void document.fonts.ready.then(() => syncNavLayout());
		}
		syncNavLayout();
	}

	menu?.addEventListener('toggle', (event) => {
		const open =
			'newState' in event
				? (event as ToggleEvent).newState === 'open'
				: isMenuOpen();
		menuButton?.setAttribute('aria-expanded', String(open));
		if (open) {
			requestAnimationFrame(() => placeMenuNearButton());
		} else {
			clearMenuPosition();
		}
	});

	const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
	const supportsScrollTargetGroup = CSS.supports('scroll-target-group: auto');

	const setCurrent = (id: string | null) => {
		for (const link of navLinks) {
			const href = link.getAttribute('href');
			const active = id !== null && href === `#${id}`;
			if (active) {
				link.setAttribute('aria-current', 'true');
				link.classList.add('target-current');
			} else {
				link.removeAttribute('aria-current');
				link.classList.remove('target-current');
			}
		}
	};

	const syncAriaFromTargetCurrent = () => {
		const current = document.querySelector<HTMLAnchorElement>(
			'.site-menu a:target-current, .site-menu a.target-current',
		);
		for (const link of navLinks) {
			const active = link === current;
			if (active) link.setAttribute('aria-current', 'true');
			else link.removeAttribute('aria-current');
		}
	};

	if (supportsScrollTargetGroup) {
		syncAriaFromTargetCurrent();
		document.addEventListener('scrollend', syncAriaFromTargetCurrent);
	} else {
		const sections = ['sobre-mi', 'experiencia', 'proyectos', 'habilidades', 'educacion', 'contacto']
			.map((id) => document.getElementById(id))
			.filter((el): el is HTMLElement => el instanceof HTMLElement);

		if (sections.length && 'IntersectionObserver' in window) {
			const ratios = new Map<string, number>();
			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						ratios.set(entry.target.id, entry.isIntersecting ? entry.intersectionRatio : 0);
					}
					let bestId: string | null = null;
					let bestRatio = 0;
					for (const [id, ratio] of ratios) {
						if (ratio > bestRatio) {
							bestRatio = ratio;
							bestId = id;
						}
					}
					setCurrent(bestId);
				},
				{ rootMargin: '-20% 0px -55% 0px', threshold: [0, 0.2, 0.4, 0.6, 0.8] },
			);
			for (const section of sections) observer.observe(section);
		}
	}

	const clearHashFromUrl = () => {
		if (!location.hash) return;
		history.replaceState(null, '', `${location.pathname}${location.search}`);
	};

	const prefersReducedMotion = () =>
		window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	let scrollToken = 0;

	const scrollIntoViewAsync = (element: HTMLElement, options: ScrollIntoViewOptions) => {
		const result = element.scrollIntoView(options);
		if (result instanceof Promise) return result;

		return new Promise<void>((resolve) => {
			let timeoutId = 0;
			const finish = () => {
				window.clearTimeout(timeoutId);
				window.removeEventListener('scrollend', finish);
				window.removeEventListener('scroll', onScroll);
				resolve();
			};
			const onScroll = () => {
				window.clearTimeout(timeoutId);
				timeoutId = window.setTimeout(finish, 100);
			};
			window.addEventListener('scrollend', finish, { once: true });
			window.addEventListener('scroll', onScroll, { passive: true });
			timeoutId = window.setTimeout(finish, 100);
		});
	};

	const focusTarget = (element: HTMLElement) => {
		const heading = element.matches('h1, h2, h3, h4, h5, h6')
			? element
			: element.querySelector<HTMLElement>('h1, h2, h3, h4, h5, h6');
		const target = heading ?? element;
		if (!target.hasAttribute('tabindex') && !target.matches('a, button, input, textarea, select')) {
			target.tabIndex = -1;
		}
		target.focus({ preventScroll: true });
	};

	const goToSection = async (id: string, { focus = true }: { focus?: boolean } = {}) => {
		const element = document.getElementById(id);
		if (!(element instanceof HTMLElement)) return false;

		if (isMenuOpen() && menu && 'hidePopover' in menu) {
			try {
				(menu as HTMLElement & { hidePopover: () => void }).hidePopover();
			} catch {}
		}

		const token = ++scrollToken;
		await scrollIntoViewAsync(element, {
			behavior: prefersReducedMotion() ? 'auto' : 'smooth',
			block: 'start',
		});

		if (token !== scrollToken) return true;
		if (focus) focusTarget(element);
		clearHashFromUrl();
		if (supportsScrollTargetGroup) syncAriaFromTargetCurrent();
		return true;
	};

	document.addEventListener('click', (event) => {
		const link = (event.target as Element | null)?.closest?.('a[href^="#"]');
		if (!(link instanceof HTMLAnchorElement)) return;
		if (link.origin !== location.origin || link.pathname !== location.pathname) return;

		const href = link.getAttribute('href');
		if (!href || href === '#') return;

		const id = decodeURIComponent(href.slice(1));
		if (!document.getElementById(id)) return;

		event.preventDefault();
		void goToSection(id);
	});

	if (location.hash) {
		const id = decodeURIComponent(location.hash.slice(1));
		void goToSection(id, { focus: false }).then((ok) => {
			if (!ok) clearHashFromUrl();
		});
	}
</script>
