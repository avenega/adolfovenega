---
import { profile } from '../data/profile';

const links = [
	{ href: '#sobre-mi', label: 'Sobre mí' },
	{ href: '#experiencia', label: 'Experiencia' },
	{ href: '#proyectos', label: 'Proyectos' },
	{ href: '#habilidades', label: 'Habilidades' },
	{ href: '#contacto', label: 'Contacto' },
];
---

<header class="site-header">
	<div class="site-header__bar">
		<div class="site-shell site-header__inner">
			<a class="brand" href="#inicio">{profile.shortName.split(' ')[0]} <span>Venega</span></a>

			<nav aria-label="Principal">
				<ul class="nav-desktop" data-nav>
					{
						links.map((link) => (
							<li>
								<a href={link.href} data-nav-link>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<div class="header-actions">
				<button
					type="button"
					class="icon-button theme-toggle"
					id="theme-toggle"
					aria-label="Cambiar tema"
				>
					<svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
						<path d="M21 14.3A8.5 8.5 0 0 1 9.7 3 7 7 0 1 0 21 14.3Z"></path>
					</svg>
					<svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
						<circle cx="12" cy="12" r="4"></circle>
						<path
							d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
						></path>
					</svg>
				</button>

				<button
					class="icon-button menu-button"
					type="button"
					id="drawer-open"
					aria-label="Abrir menú"
					aria-expanded="false"
					aria-controls="drawer"
				>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M4 7h16M4 12h16M4 17h16"></path>
					</svg>
				</button>
			</div>
		</div>
	</div>
</header>

<dialog class="Drawer" id="drawer" aria-label="Menú de navegación">
	<div class="Drawer-sheet">
		<button
			class="icon-button drawer-close"
			type="button"
			id="drawer-close"
			aria-label="Cerrar menú"
			autofocus
		>
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path d="M6 6l12 12M18 6L6 18"></path>
			</svg>
		</button>
		<nav aria-label="Móvil">
			<ul data-nav>
				{
					links.map((link) => (
						<li>
							<a href={link.href} data-drawer-link data-nav-link>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</dialog>

<script>
	const meta = document.querySelector('meta[name="color-scheme"]');
	const themeBtn = document.getElementById('theme-toggle');
	const drawer = document.getElementById('drawer');
	const openBtn = document.getElementById('drawer-open');
	const closeBtn = document.getElementById('drawer-close');

	const getSystemScheme = () =>
		window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';

	const getRenderedScheme = () => {
		const stored = meta instanceof HTMLMetaElement ? meta.content : 'light dark';
		if (stored === 'light' || stored === 'dark') return stored;
		return getSystemScheme();
	};

	const applyScheme = (value: string | null) => {
		if (!(meta instanceof HTMLMetaElement)) return;
		if (!value) {
			meta.content = 'light dark';
			try {
				localStorage.removeItem('color-scheme');
			} catch {}
			return;
		}
		meta.content = value;
		try {
			localStorage.setItem('color-scheme', value);
		} catch {}
	};

	const syncThemeLabel = () => {
		if (!(themeBtn instanceof HTMLButtonElement)) return;
		themeBtn.setAttribute(
			'aria-label',
			getRenderedScheme() === 'dark' ? 'Cambiar a tema claro' : 'Cambiar a tema oscuro',
		);
	};

	syncThemeLabel();

	themeBtn?.addEventListener('click', () => {
		const current = getRenderedScheme();
		const target = current === 'dark' ? 'light' : 'dark';
		if (target === getSystemScheme()) {
			applyScheme(null);
		} else {
			applyScheme(target);
		}
		syncThemeLabel();
	});

	window.addEventListener('storage', (event) => {
		if (event.key !== 'color-scheme' || !(meta instanceof HTMLMetaElement)) return;
		meta.content = event.newValue ?? 'light dark';
	});

	if (
		drawer instanceof HTMLDialogElement &&
		openBtn instanceof HTMLButtonElement &&
		closeBtn instanceof HTMLButtonElement
	) {
		const setExpanded = (value: boolean) => {
			openBtn.setAttribute('aria-expanded', String(value));
		};

		const openDrawer = () => {
			drawer.showModal();
			setExpanded(true);
		};

		const closeDrawer = () => {
			drawer.close();
			setExpanded(false);
		};

		openBtn.addEventListener('click', openDrawer);
		closeBtn.addEventListener('click', closeDrawer);

		drawer.addEventListener('click', (event) => {
			if (event.target === drawer) closeDrawer();
		});

		drawer.addEventListener('cancel', (event) => {
			event.preventDefault();
			closeDrawer();
		});

		drawer.querySelectorAll('[data-drawer-link]').forEach((link) => {
			link.addEventListener('click', () => closeDrawer());
		});
	}

	const sections = ['sobre-mi', 'experiencia', 'proyectos', 'habilidades', 'educacion', 'contacto']
		.map((id) => document.getElementById(id))
		.filter((el): el is HTMLElement => el instanceof HTMLElement);

	const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];

	const setCurrent = (id: string | null) => {
		for (const link of navLinks) {
			const href = link.getAttribute('href');
			const active = id !== null && href === `#${id}`;
			if (active) link.setAttribute('aria-current', 'true');
			else link.removeAttribute('aria-current');
		}
	};

	if (sections.length && 'IntersectionObserver' in window) {
		const ratios = new Map<string, number>();
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					ratios.set(entry.target.id, entry.isIntersecting ? entry.intersectionRatio : 0);
				}
				let bestId: string | null = null;
				let bestRatio = 0;
				for (const [id, ratio] of ratios) {
					if (ratio > bestRatio) {
						bestRatio = ratio;
						bestId = id;
					}
				}
				setCurrent(bestId);
			},
			{ rootMargin: '-20% 0px -55% 0px', threshold: [0, 0.2, 0.4, 0.6, 0.8] },
		);

		for (const section of sections) observer.observe(section);
	}
</script>
